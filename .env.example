# ─────────────────────────────────────────────────────────────────────────────
# Fills — environment variables template
#
# For LOCAL development:
#   1. Copy this file to `.env.local` (which is gitignored)
#   2. Fill in the real values (find them in 1Password / Bitwarden under "Fills")
#
# For PRODUCTION:
#   These are already set in Vercel → fills project → Settings → Environment Variables.
#   Do not commit real values to this file.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Postgres — connection string from the Supabase dashboard
# (Settings → Database → Connection string → Transaction pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<your-password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase API — public-safe values (the anon key is meant to be exposed client-side)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Apify — Pinterest scraper API token
APIFY_TOKEN=<your-apify-token>

# OpenAI — AI text (and images in a later phase)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-key>

# (Optional) Which provider to route text calls through. Defaults to "openai".
# Set to "anthropic" / "gemini" / etc. when those adapters are wired up.
# TEXT_PROVIDER=openai

# Gmail — emails the team when a lead or "talk to a designer" enquiry arrives,
# sent from the company Google Workspace mailbox. Without these, leads still
# save and no email is sent. See src/lib/lead-alert.ts.
#
# GMAIL_APP_PASSWORD is a Google "app password", not the normal login password:
# Google Account → Security → 2-Step Verification (must be on) → App passwords.
# It can read and send everything in that mailbox, so it lives only in Vercel.
# GMAIL_USER=aisha@fills.io
# GMAIL_APP_PASSWORD=<16-character app password>
# (Optional) Who gets the alert. Defaults to GMAIL_USER. Comma-separate for more.
# LEAD_ALERT_TO=aisha@fills.io
